# Địa chỉ backend NestJS (đăng nhập, đặt tour, lịch sử...). Khi demo dùng Cloudflare Tunnel: https://xxxx.trycloudflare.com
VITE_API_URL=https://your-nestjs-host.example.com
# API tour công khai của BenThanh Tourist (Laravel)
VITE_BASE_BTT_URL=https://benthanhtourist.com
# Chatbot bttAI (FastAPI trong D:\ChatBot). Cần CORS cho origin của mini app (chatbot đã cho phép localhost, *.mini.123c.vn, h5.zdn.vn).
VITE_CHATBOT_URL=https://your-chatbot-host.example.com

# Chỉ dùng khi deploy bằng zmp-cli — KHÔNG commit giá trị thật
APP_ID=
ZMP_TOKEN=
